# ── Local development (copy this file to .env) ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_PASSWORD_HERE
DB_NAME=era_db

# Random text, at least 32 characters. Keep it secret.
ERA_SESSION_SECRET=YOUR_RANDOM_SECRET_HERE

# ── Railway (set these in the service's Variables tab instead of a .env file) ──
# MYSQL_URL=${{MySQL.MYSQL_URL}}       # reference to your Railway MySQL service
# ERA_SESSION_SECRET=...               # random, 32+ characters
# ERA_DEMO_PASSWORD=...                # password for the demo accounts (use a strong one)
# ERA_SEED_DEMO=false                  # optional: start with an empty site instead of demo content
